                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="宽度" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="width" Click="OnGroupReset" AutomationProperties.Name="恢复宽度的默认值" />
                                </Grid>
                                <StackPanel x:Name="WidthRows">
                                    <local:ToggleTile x:Name="AutoWidthSwitch" Title="自动宽度" SwitchName="自动宽度" Toggled="OnAutoWidthToggled" Flat="True"
                                                      Note="玻璃栏随内容伸缩，像一枚贴合物品的胶囊；关闭后固定为“最大宽度”。" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dock: what the bar shows, the icons, place and motion -->
                        <StackPanel x:Name="SideDock" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="模块" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="BarSwitch" Title="Yunzhao 任务栏" SwitchName="Yunzhao 任务栏" Toggled="OnBarToggled" Flat="True"
                                                  Note="关闭后用回 Windows 自己的任务栏和通知横幅；桌面组件不受影响。" />
                                <local:ToggleTile x:Name="LaunchpadSwitch" Title="启动台" SwitchName="启动台" Toggled="OnLaunchpadToggled" Flat="True"
                                                  Note="开始键右侧一个图标，点开是全部应用的大网格，可分页、搜索、拖动排序。" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="启动台的大小" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                        <RadioButton x:Name="LaunchpadWindow" GroupName="lplayout" Content="窗口" Tag="window" Style="{StaticResource SegmentStyle}" Checked="OnLaunchpadLayoutChecked" />
                                        <RadioButton x:Name="LaunchpadFull" GroupName="lplayout" Content="全屏" Tag="fullscreen" Style="{StaticResource SegmentStyle}" Checked="OnLaunchpadLayoutChecked" />
                                    </local:SegmentTrack>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="启动台的材质" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                        <RadioButton x:Name="LaunchpadBar" GroupName="lpmaterial" Content="跟任务栏一样" Tag="bar" Style="{StaticResource SegmentStyle}" Checked="OnLaunchpadMaterialChecked" />
                                        <RadioButton x:Name="LaunchpadTint" GroupName="lpmaterial" Content="深色蒙层" Tag="tint" Style="{StaticResource SegmentStyle}" Checked="OnLaunchpadMaterialChecked" />
                                    </local:SegmentTrack>
                                </StackPanel>
                                <local:ToggleTile x:Name="FolderStacksSwitch" Title="文件夹堆栈" SwitchName="文件夹堆栈" Toggled="OnFolderStacksToggled" Flat="True"
                                                  Note="托盘左侧一个图标，点开时常用文件夹和文件沿弧线飞散排开。" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="堆栈的排法" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                        <RadioButton x:Name="StackFan" GroupName="stacklayout" Content="弧形飞散" Tag="fan" Style="{StaticResource SegmentStyle}" Checked="OnStackLayoutChecked" />
                                        <RadioButton x:Name="StackColumn" GroupName="stacklayout" Content="竖排" Tag="column" Style="{StaticResource SegmentStyle}" Checked="OnStackLayoutChecked" />
                                    </local:SegmentTrack>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <Grid>
                                        <TextBlock Text="堆栈里的文件夹" Style="{StaticResource RowTitleStyle}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button x:Name="AddStackFolderButton" Content="添加文件夹…" Click="OnAddStackFolder" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="StackCountText" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel x:Name="StackFolderList" Spacing="4" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="DockContent">
                                <TextBlock Text="栏上显示" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="RunningSwitch" Title="正在运行的应用" SwitchName="显示正在运行的应用" Toggled="OnRunningToggled" Flat="True"
                                                  Note="固定的应用之后，显示正在运行的其他应用，下方带一个小圆点。" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="文字颜色" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="TextAuto" GroupName="ink" Content="自动" Tag="auto" Style="{StaticResource SegmentStyle}" Checked="OnTextColorChecked" />
                                            <RadioButton x:Name="TextLight" GroupName="ink" Content="浅色" Tag="light" Style="{StaticResource SegmentStyle}" Checked="OnTextColorChecked" />
                                            <RadioButton x:Name="TextDark" GroupName="ink" Content="深色" Tag="dark" Style="{StaticResource SegmentStyle}" Checked="OnTextColorChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="显示方式" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="HideNever" GroupName="autohide" Content="常驻" Tag="never" Style="{StaticResource SegmentStyle}" Checked="OnAutoHideChecked" />
                                            <RadioButton x:Name="HideFullscreen" GroupName="autohide" Content="全屏时隐藏" Tag="fullscreen" Style="{StaticResource SegmentStyle}" Checked="OnAutoHideChecked" />
                                            <RadioButton x:Name="HideAlways" GroupName="autohide" Content="一直隐藏" Tag="always" Style="{StaticResource SegmentStyle}" Checked="OnAutoHideChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                                <local:SliderTile x:Name="BarRevealDelay" />
                                <local:SliderTile x:Name="BarHideDelay" />
                            </StackPanel>
                            <StackPanel x:Name="DockLayout">
                                <Grid>
                                    <TextBlock Text="图标与位置" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="dock" Click="OnGroupReset" AutomationProperties.Name="恢复图标与位置的默认值" />
                                </Grid>
                                <StackPanel x:Name="DockRows" />
                            </StackPanel>
                        </StackPanel>

                        <!-- The start menu: its size, the status and the tray's buttons in its capsule -->
                        <StackPanel x:Name="SideStart" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="开始菜单" Style="{StaticResource SectionStyle}" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="大小" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                        <RadioButton x:Name="StartSmall" GroupName="startsize" Content="小" Tag="small" Style="{StaticResource SegmentStyle}" Checked="OnStartSizeChecked" />
                                        <RadioButton x:Name="StartMedium" GroupName="startsize" Content="中" Tag="medium" Style="{StaticResource SegmentStyle}" Checked="OnStartSizeChecked" />
                                        <RadioButton x:Name="StartLarge" GroupName="startsize" Content="大" Tag="large" Style="{StaticResource SegmentStyle}" Checked="OnStartSizeChecked" />
                                    </local:SegmentTrack>
                                </StackPanel>
                                <local:ToggleTile x:Name="StartStatusSwitch" Title="状态栏" SwitchName="开始菜单里的状态栏" Toggled="OnBarContentToggled" Flat="True" />
                                <local:ToggleTile x:Name="StartTraySwitch" Title="托盘按钮" SwitchName="开始菜单里的托盘按钮" Toggled="OnBarContentToggled" Flat="True" />
                            </StackPanel>
                        </StackPanel>

                        <!-- The tray -->
                        <StackPanel x:Name="SideTray" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="托盘" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="TraySwitch" Title="在任务栏上显示" SwitchName="显示系统托盘" Toggled="OnBarContentToggled" Flat="True" />
                            </StackPanel>
                        </StackPanel>

                        <!-- The status entry: shown, as a ring or as icons -->
                        <StackPanel x:Name="SideStatus" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="状态栏" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="StatusSwitch" Title="在任务栏上显示" SwitchName="显示状态栏" Toggled="OnBarContentToggled" Flat="True" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="图标" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                        <RadioButton x:Name="StatusRing" GroupName="statusstyle" Content="圆环" Tag="ring" Style="{StaticResource SegmentStyle}" Checked="OnStatusStyleChecked" />
                                        <RadioButton x:Name="StatusIcons" GroupName="statusstyle" Content="系统图标" Tag="icons" Style="{StaticResource SegmentStyle}" Checked="OnStatusStyleChecked" />
                                    </local:SegmentTrack>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- The time -->
                        <StackPanel x:Name="SideClock" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="时间" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="ClockSwitch" Title="时钟和日期" SwitchName="显示时钟和日期" Toggled="OnClockToggled" Flat="True" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Notifications: the bell, how long, what they show, where from -->
                        <StackPanel x:Name="SideNotify" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="任务栏" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="NotificationsSwitch" Title="通知按钮" SwitchName="显示通知按钮" Toggled="OnBarContentToggled" Flat="True" Visibility="Collapsed" />
                                <TextBlock Text="通知显示在屏幕顶部的灵动岛上，任务栏不再放通知按钮。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="弹出" Style="{StaticResource SectionStyle}" />
                                    <Button Style="{StaticResource ResetButtonStyle}" Tag="notify" Click="OnGroupReset" AutomationProperties.Name="恢复弹出的默认值" />
                                </Grid>
                                <StackPanel x:Name="NotifyRows">
                                    <StackPanel Style="{StaticResource FlatRowStyle}">
                                        <TextBlock Text="通知位置" Style="{StaticResource RowTitleStyle}" />
                                        <local:SegmentTrack>
                                            <RadioButton x:Name="NotifyAtDock" GroupName="notifyplacement" Content="跟随任务栏" Tag="dock" Style="{StaticResource SegmentStyle}" Checked="OnNotifyPlacementChecked" />
                                            <RadioButton x:Name="NotifyAtTopRight" GroupName="notifyplacement" Content="主屏右上角" Tag="topRight" Style="{StaticResource SegmentStyle}" Checked="OnNotifyPlacementChecked" />
                                        </local:SegmentTrack>
                                    </StackPanel>
                                    <local:ToggleTile x:Name="HideBodySwitch" Title="隐藏通知正文" SwitchName="隐藏通知正文" Toggled="OnHideBodyToggled" Flat="True"
                                                      Note="卡片只显示应用和标题；通知窗口同时不会出现在截图和屏幕共享里。" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="来源" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="ListenerSwitch" Title="Windows 通知" SwitchName="显示 Windows 通知" Toggled="OnListenerToggled" Flat="True"
                                                  Note="QQ 等发出系统通知的应用。需要在 Windows 隐私设置中允许访问通知。" />
                                <local:ToggleTile x:Name="WeChatSwitch" Title="微信" SwitchName="显示微信消息" Toggled="OnWeChatToggled" Flat="True"
                                                  Note="只读微信窗口里的会话列表，有新的未读消息时显示卡片；免打扰的会话不提醒。" />
                                <local:ToggleTile x:Name="FeishuSwitch" Title="飞书" SwitchName="显示飞书消息" Toggled="OnFeishuToggled" Flat="True"
                                                  Note="只读飞书弹窗里的文字，同时显示为卡片；点击卡片打开飞书。" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Stage Manager: on or off, its side; how it is used -->
                        <StackPanel x:Name="SideStage" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="窗口" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="StageSwitch" Title="台前调度" SwitchName="台前调度" Toggled="OnStageToggled" Flat="True"
                                                  Note="前面的应用留在屏幕中间，其他应用的窗口斜立在屏幕一侧，各带阴影和应用图标。" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="最近使用的应用" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="StageLeft" GroupName="stageside" Content="左侧" Tag="left" Style="{StaticResource SegmentStyle}" Checked="OnStageSideChecked" />
                                            <RadioButton x:Name="StageRight" GroupName="stageside" Content="右侧" Tag="right" Style="{StaticResource SegmentStyle}" Checked="OnStageSideChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="显示方式" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="StageAlways" GroupName="stagemode" Content="常驻" Tag="always" Style="{StaticResource SegmentStyle}" Checked="OnStageModeChecked" />
                                            <RadioButton x:Name="StageAutoHide" GroupName="stagemode" Content="悬停弹出" Tag="hover" Style="{StaticResource SegmentStyle}" Checked="OnStageModeChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                                <local:ToggleTile x:Name="StageMinimizeSwitch" Title="窗口最小化到台前调度" SwitchName="窗口最小化到台前调度" Toggled="OnStageMinimizeToggled" Flat="True" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="操作" Style="{StaticResource SectionStyle}" />
                                <StackPanel Style="{StaticResource FlatRowStyle}" Spacing="2">
                                    <TextBlock Text="点按卡片" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="换到前面，原来前面的应用收进一侧。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}" Spacing="2">
                                    <TextBlock Text="Shift + 点按" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="加入当前这一组，之后一起收起、一起回来。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}" Spacing="2">
                                    <TextBlock Text="指针移到屏幕边缘" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="卡片从边缘滑出，浮在窗口上面；指针离开后收回。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}" Spacing="2">
                                    <TextBlock Text="关闭或退出" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="收起的窗口全部恢复。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Widgets: on or off, what the glass shows -->
                        <StackPanel x:Name="SideWidgets" Style="{StaticResource InspectorPageStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="桌面" Style="{StaticResource SectionStyle}" />
                                <local:ToggleTile x:Name="WidgetsSwitch" Title="桌面组件" SwitchName="桌面组件" Toggled="OnWidgetsToggled" Flat="True"
                                                  Note="拖动可移动，拖下角可改变大小，右键可移除。" />
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="靠边排列" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="WidgetsLeft" GroupName="widgetside" Content="左侧" Tag="left" Style="{StaticResource SegmentStyle}" Checked="OnWidgetAlignmentChecked" />
                                            <RadioButton x:Name="WidgetsRight" GroupName="widgetside" Content="右侧" Tag="right" Style="{StaticResource SegmentStyle}" Checked="OnWidgetAlignmentChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="材质" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="MaterialGlass" GroupName="widgetmaterial" Content="玻璃" Tag="glass" Style="{StaticResource SegmentStyle}" Checked="OnWidgetMaterialChecked" />
                                            <RadioButton x:Name="MaterialDusk" GroupName="widgetmaterial" Content="暮色" Tag="dusk" Style="{StaticResource SegmentStyle}" Checked="OnWidgetMaterialChecked" />
                                            <RadioButton x:Name="MaterialColor" GroupName="widgetmaterial" Content="原色" Tag="color" Style="{StaticResource SegmentStyle}" Checked="OnWidgetMaterialChecked" />
                                        </local:SegmentTrack>
                                    <TextBlock Text="只影响组件，不改变任务栏的玻璃、模糊和文字颜色。" Style="{StaticResource RowNoteStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FlatRowStyle}">
                                    <TextBlock Text="玻璃映出" Style="{StaticResource RowTitleStyle}" />
                                    <local:SegmentTrack>
                                            <RadioButton x:Name="BackdropDesktop" GroupName="backdrop" Content="实时桌面" Tag="desktop" Style="{StaticResource SegmentStyle}" Checked="OnWidgetBackdropChecked" />
                                            <RadioButton x:Name="BackdropWallpaper" GroupName="backdrop" Content="静态壁纸" Tag="wallpaper" Style="{StaticResource SegmentStyle}" Checked="OnWidgetBackdropChecked" />
                                        </local:SegmentTrack>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="SideCalendar" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="TeacherHost" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{ThemeResource PageBrush}">
                <WebView2 x:Name="TeacherView" NavigationCompleted="OnTeacherNavigated" />
                <TextBlock x:Name="TeacherStatus" Text="正在打开教师工作台…" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource TitleFont}" FontSize="14" />
            </Grid>

            <!-- Errors: a quiet banner over the workspace's top -->
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" MaxWidth="760" Margin="32,12,32,0" VerticalAlignment="Top" />

        </Grid>
    </Grid>
</Window>

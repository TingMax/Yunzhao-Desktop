<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Yunzhao.Settings</RootNamespace>
    <AssemblyName>Yunzhao.Settings</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <StartupObject>Yunzhao.Settings.Program</StartupObject>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Unpackaged and self-contained: runs from a plain folder, no runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Needed for `dotnet publish` to include the compiled XAML (.xbf) and resources.pri. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <!-- Diagnostics and hot-reload support are not part of the running app. -->
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <YunzhaoDevelopment Condition="'$(YunzhaoDevelopment)' == ''">true</YunzhaoDevelopment>
    <DefineConstants Condition="'$(YunzhaoDevelopment)' == 'true'">$(DefineConstants);YUNZHAO_DEVELOPMENT</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\yunzhao.ico</ApplicationIcon>
    <Version>2.6.13</Version>
    <Product>Yunzhao</Product>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\tools\Update.ps1" Link="Update.ps1" CopyToOutputDirectory="PreserveNewest" />
    <!-- WinUI component only: the metapackage would also ship AI/ML/Search/Widgets
         (onnxruntime, DirectML, ...) in a self-contained build. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <!-- Device-independent paths clip the platform acrylic without replacing its material. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\yunzhao.ico" Link="Assets\yunzhao.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\yunzhao-256.png" Link="Assets\yunzhao-256.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Stage Manager page's windows and icons (drawn by the export-stage-art option of a development build). -->
    <Content Include="..\..\assets\stage\*.png" Link="Assets\Stage\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\backgrounds\*.jpg;..\..\assets\backgrounds\README.md" Link="Assets\Backgrounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The interface face (D40); the core reads it from here too (Settings\Fonts). -->
    <Content Include="..\..\assets\fonts\*.otf;..\..\assets\fonts\README.md" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
